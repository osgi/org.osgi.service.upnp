                                 <fo:basic-link internal-destination="org.osgi.service.upnp.UPnPIcon.getMimeType--">
                                    <fo:inline color="inherit"
                                               font-family="inherit"
                                               letter-spacing="inherit"
                                               hyphenate="inherit">UPnPIcon.getMimeType()</fo:inline>
                                 </fo:basic-link>
                              </fo:block>
