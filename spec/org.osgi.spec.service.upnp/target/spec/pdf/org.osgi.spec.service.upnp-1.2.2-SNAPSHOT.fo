               <fo:block id="org.osgi.service.upnp.UPnPService.getId--">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>111.16.8.5</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public abstract String getId()</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:inline font-weight="normal"
                                            font-style="normal"
                                            baseline-shift="-1pt"
                                            font-size="9pt">□</fo:inline>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
Returns the {@code serviceId} field in the UPnP service description.
 
 
 </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
 For standard services defined by a UPnP Forum working committee, the
 serviceId must contain the following components in the indicated order:
 </fo:block>
                  <fo:list-block space-before.optimum="1em"
                                 space-before.minimum="0.8em"
                                 space-before.maximum="1.2em"
                                 space-after.optimum="1em"
                                 space-after.minimum="0.8em"
                                 space-after.maximum="1.2em"
                                 provisional-label-separation="0.2em"
                                 provisional-distance-between-starts="12pt"
                                 id="d315e1347">
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d315e1348">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>{@code urn:upnp-org:serviceId:}</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d315e1350">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>service ID suffix</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                  </fo:list-block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
 Example: {@code urn:upnp-org:serviceId:serviceID}.
 
 </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
 Note that {@code upnp-org} is used instead of {@code schemas-upnp-org} in
 this example because an XML schema is not defined for each serviceId.
 </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
 For non-standard services specified by UPnP vendors, the serviceId must
 contain the following components in the indicated order:
 </fo:block>
                  <fo:list-block space-before.optimum="1em"
                                 space-before.minimum="0.8em"
                                 space-before.maximum="1.2em"
                                 space-after.optimum="1em"
                                 space-after.minimum="0.8em"
                                 space-after.maximum="1.2em"
                                 provisional-label-separation="0.2em"
                                 provisional-distance-between-starts="12pt"
                                 id="d315e1355">
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d315e1356">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>{@code urn:}</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d315e1358">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>ICANN domain name owned by the vendor</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d315e1360">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>{@code :serviceId:}</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d315e1362">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>service ID suffix</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                  </fo:list-block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
 Example: {@code urn:domain-name:serviceId:serviceID}.
 
 </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
 This method must continue to return the service id after the UPnP service
 has been removed from the network.</fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>Returns</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>The service ID suffix defined by a UPnP Forum working committee
         or specified by a UPnP vendor. Must be &lt;= 64 characters.
         Single URI.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
               </fo:block>
